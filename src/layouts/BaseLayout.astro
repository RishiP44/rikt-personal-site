---
import { navigation } from "../lib/navigation";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const path = Astro.url.pathname;
const normalizedPath =
  path.endsWith("/") || path.endsWith(".html") ? path : `${path}/`;
const canonical = Astro.site
  ? new URL(normalizedPath, Astro.site).href
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | RIKT</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow"}
    />
    {canonical && <link rel="canonical" href={canonical} />}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <a class="site-identity" href="/" aria-label="RIKT home">
        RIKT
      </a>
      <nav aria-label="Main navigation">
        <ul class="navigation">
          {navigation.map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={
                  normalizedPath.startsWith(href) ? "page" : undefined
                }
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer>
      <p>RIKT — Rishi Patel</p>
    </footer>
  </body>
</html>
