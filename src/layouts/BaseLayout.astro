---
import SiteHeader from "../components/SiteHeader.astro";
import ThemeSwitch from "../components/ThemeSwitch.astro";
import { navigation } from "../lib/navigation";
import "../styles/global.css";
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  home?: boolean;
}
const { title, description, noindex = false, home = false } = Astro.props;
const path = Astro.url.pathname;
const normalizedPath =
  path.endsWith("/") || path.endsWith(".html") ? path : `${path}/`;
const canonical = Astro.site
  ? new URL(normalizedPath, Astro.site).href
  : undefined;
---

<!doctype html>
<html lang="en" class={home ? "home" : "inner"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#eceee9" />
    <title>{title} — RIKT / Rishi Patel</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow"}
    />
    <meta property="og:title" content={`${title} — RIKT`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/assets/manrope.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <script is:inline>
      try {
        document.documentElement.dataset.theme =
          localStorage.getItem("rikt-theme") === "dark" ? "dark" : "light";
      } catch {}
    </script>
    <script is:inline src="/scripts/site.js" defer></script>
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <ThemeSwitch />
    {!home && <SiteHeader />}
    <main id="main" tabindex="-1" class:list={{ "inner-page": !home }}>
      <slot />
      {!home && (
        <>
          <nav class="page-nav" aria-label="Return navigation">
            <a href="/#drawing">← Back to the apparatus</a>
            <a href="/about/">The person behind it ↗</a>
          </nav>
          <nav class="archive-navigation mono" aria-label="Archive navigation">
            {navigation.map(({ href, label }) => (
              <a href={href}>{label}</a>
            ))}
          </nav>
        </>
      )}
    </main>
  </body>
</html>
