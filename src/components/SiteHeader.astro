---
interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;
---

<header class="topbar">
  <a class="brand" href="/" aria-label="RIKT home">
    <span class="wordmark">RIKT</span>
    <span class="descriptor">
      RISHI PATEL
      <br />A PERSONAL COLLECTION
    </span>
  </a>
  {!home && (
    <a class="back-link" href="/#drawing">
      ← Back to the machine
    </a>
  )}
</header>
