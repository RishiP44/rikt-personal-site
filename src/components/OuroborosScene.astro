---
import fallback from "../assets/ouroboros.svg?raw";
import { chapters } from "../lib/apparatus";
---

<div class="apparatus" data-apparatus data-render-state="static">
  <div class="apparatus-viewport">
    <div class="apparatus-fallback" set:html={fallback} />
    <canvas
      class="apparatus-canvas"
      role="img"
      aria-label="Interactive sculpture of Sisyphus inside an Ouroboros. Drag to rotate freely."
      aria-describedby="inspection-help"
      tabindex="0"
      hidden
    ></canvas>
  </div>
  <svg class="apparatus-rays" aria-hidden="true">
    {chapters.map(({ id }) => (
      <g data-marker={id}>
        <line data-ray={id} />
        <circle data-pin={id} r="4" />
        <circle data-halo={id} r="10" />
      </g>
    ))}
  </svg>
  <nav class="plate-index" aria-label="Apparatus destinations">
    {chapters.map(({ id, number, label, href }) => (
      <a class="part" href={href} aria-label={label} data-scene-node={id}>
        <span class="node-mark">{number}</span>
        <span class="node-name">{label}</span>
        <span class="node-arrow" aria-hidden="true">
          ↗
        </span>
      </a>
    ))}
  </nav>
  <div class="apparatus-controls" hidden>
    <div class="inspection-tools" role="group" aria-label="Sculpture controls">
      <button type="button" data-control="reset" aria-label="Reset view">
        ↺
      </button>
      <button type="button" data-control="zoom-out" aria-label="Zoom out">
        −
      </button>
      <button type="button" data-control="zoom-in" aria-label="Zoom in">
        +
      </button>
      <button type="button" data-control="roll-left" aria-label="Roll left">
        ↶
      </button>
      <button type="button" data-control="roll-right" aria-label="Roll right">
        ↷
      </button>
      <button
        type="button"
        data-control="pause"
        aria-label="Pause sculpture motion"
        aria-pressed="false"
      >
        Ⅱ
      </button>
    </div>
    <details class="inspection-help">
      <summary>Controls</summary>
      <p id="inspection-help">
        Drag to orbit. Pinch to zoom. Twist with two fingers to roll. Right-drag
        to pan. With the sculpture focused: arrows rotate, Q / E roll, + / −
        zoom, Home resets, Space pauses. Select a point to visit its page.
      </p>
    </details>
  </div>
  <footer class="sculpture-footer mono">
    <span>Sisyphus / Ouroboros</span>
    <span data-gesture-note>Six points. Six destinations.</span>
  </footer>
</div>
<script>
  void import("../scripts/ouroboros").catch(() => {});
</script>
