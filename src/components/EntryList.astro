---
import { formatDate, type Archive } from "../lib/content";
interface Props {
  archive: Archive;
  entries: {
    data: {
      slug: string;
      title: string;
      description: string;
      publishedDate?: string;
      subtitle?: string;
      tags?: string[];
    };
  }[];
}
const { archive, entries } = Astro.props;
---

<ul class="entries entry-list">
  {entries.map(({ data }, index) => (
    <li class="entry">
      <div class="mono">{String(index + 1).padStart(2, "0")}</div>
      <div>
        <h2>
          <a href={`/${archive}/${data.slug}/`}>{data.title}</a>
        </h2>
        {data.subtitle && <div class="project-meta">{data.subtitle}</div>}
        {data.tags?.length && (
          <div class="project-meta">{data.tags.join(" · ")}</div>
        )}
        {data.publishedDate && (
          <time class="project-meta" datetime={data.publishedDate}>
            {formatDate(data.publishedDate)}
          </time>
        )}
      </div>
      <p>{data.description}</p>
    </li>
  ))}
</ul>
