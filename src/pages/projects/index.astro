---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EntryList from "../../components/EntryList.astro";
import { getPublished } from "../../lib/content";
const entries = await getPublished("projects");
---

<BaseLayout
  title="Things taking shape."
  description="A selection of systems, experiments, and questions made tangible."
  noindex={entries.length === 0}
>
  <div class="page-heading">
    <div class="eyebrow">03 / CONSTRUCTION ASSEMBLY</div>
    <h1>Things taking shape.</h1>
    <p class="summary">
      A selection of systems, experiments, and questions made tangible.
    </p>
  </div>
  {entries.length ? (
    <EntryList archive="projects" entries={entries} />
  ) : (
    <p class="placeholder-note">
      No projects have been published yet. Good things take time.
    </p>
  )}
</BaseLayout>
