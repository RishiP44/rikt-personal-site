---
import BaseLayout from "../layouts/BaseLayout.astro";
import OuroborosScene from "../components/OuroborosScene.astro";
import { Content as Biography, frontmatter } from "../content/about.md";
import { getPublished } from "../lib/content";
import { chapters } from "../lib/apparatus";
import "../styles/apparatus.css";
const projects = await getPublished("projects");
const writing = await getPublished("writing");
---

<BaseLayout
  home
  title="The work of becoming"
  description="Rishi Patel’s evolving collection of work, projects, learning and writing. A study in effort, return, and the space to begin again."
>
  <header class="journey-header">
    <a class="journey-brand" href="#drawing" aria-label="RIKT home">
      RIKT<span>Rishi Patel</span>
    </a>
    <a class="apparatus-title mono" href="#drawing">
      Apparatus 02 / The Ouroboric Engine
    </a>
    <a class="journey-contact mono" href="/contact/">
      Say hello ↗
    </a>
  </header>
  <OuroborosScene />
  <nav class="journey-index" aria-label="Journey chapters">
    {chapters.map(({ id, number, label }) => (
      <a href={`#${id}`}>
        <span>{number}</span>
        {label}
      </a>
    ))}
  </nav>
  <div class="journey-progress" aria-hidden="true">
    <span class="journey-progress-fill"></span>
  </div>
  <div class="journey-bottom mono">
    <span data-sheet>00 / The apparatus</span>
    <span class="journey-location">Ottawa, Canada</span>
    <span data-progress>000%</span>
  </div>
  <div id="journey-content">
    <section
      class="journey-chapter journey-intro"
      id="drawing"
      data-chapter="drawing"
      aria-labelledby="intro-title"
    >
      <div class="chapter-copy">
        <p class="chapter-kicker mono">
          <span class="kicker-line"></span> A study in effort &amp; return
        </p>
        <h1 id="intro-title">
          The work
          <br />
          of <em>becoming.</em>
        </h1>
        <p class="chapter-lede">
          A life, a practice, a stone to push.
          <br />
          An ongoing collection of things I build
          <br class="desktop-break" /> and questions I follow.
        </p>
        <p class="chapter-signature">
          Rishi Patel <span>/ Developer &amp; builder</span>
        </p>
        <a class="journey-next mono" href="#about">
          Begin the journey <span aria-hidden="true">↓</span>
        </a>
      </div>
      <p class="engine-caption mono">
        The stone rolls. The serpent turns.
        <br />
        The center remains open.
      </p>
    </section>
    <section
      class="journey-chapter"
      id="about"
      data-chapter="about"
      aria-labelledby="identity-title"
    >
      <div class="chapter-copy">
        <p class="chapter-kicker mono">01 / Identity &amp; continuum</p>
        <h2 id="identity-title">
          Still learning.
          <br />
          <em>Still becoming.</em>
        </h2>
        <p class="chapter-lede">{frontmatter.lede}</p>
        <div class="chapter-biography">
          <Biography />
        </div>
        <a class="text-link" href="/about/">
          The person behind it <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
    <section
      class="journey-chapter"
      id="work"
      data-chapter="work"
      aria-labelledby="practice-title"
    >
      <div class="chapter-copy">
        <p class="chapter-kicker mono">02 / Drive &amp; practice</p>
        <h2 id="practice-title">
          Effort, given
          <br />
          <em>a direction.</em>
        </h2>
        <p class="chapter-lede">
          Experience across software, data, and the systems between them.
        </p>
        <dl class="practice-list">
          <div>
            <dt>Algonquin College</dt>
            <dd>
              Monograph Development Assistant <span>2026</span>
            </dd>
          </div>
          <div>
            <dt>Ascend Marketing</dt>
            <dd>
              Technical Product Manager <span>2025</span>
            </dd>
          </div>
          <div>
            <dt>AM/NS India</dt>
            <dd>
              BI &amp; Data Engineering Intern <span>2025</span>
            </dd>
          </div>
        </dl>
        <a class="text-link" href="/work/">
          Explore the work <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
    <section
      class="journey-chapter"
      id="projects"
      data-chapter="projects"
      aria-labelledby="builds-title"
    >
      <div class="chapter-copy">
        <p class="chapter-kicker mono">03 / Selected builds</p>
        <h2 id="builds-title">
          A thought,
          <br />
          <em>made tangible.</em>
        </h2>
        <p class="chapter-lede">
          Systems, experiments, and questions taking shape.
        </p>
        <ol class="journey-projects">
          {projects.map(({ data }, i) => (
            <li>
              <a href={`/projects/${data.slug}/`}>
                <span class="mono">{String(i + 1).padStart(2, "0")}</span>
                <span>
                  {data.title}
                  <small>{data.subtitle}</small>
                </span>
                <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ol>
        {projects.length === 0 && (
          <p>No projects have been published yet. Good things take time.</p>
        )}
        <a class="text-link" href="/projects/">
          All projects <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
    <section
      class="journey-chapter"
      id="learning"
      data-chapter="learning"
      aria-labelledby="inquiry-title"
    >
      <div class="chapter-copy">
        <p class="chapter-kicker mono">04 / Observation &amp; inquiry</p>
        <h2 id="inquiry-title">
          The path changes.
          <br />
          <em>So do I.</em>
        </h2>
        <p class="chapter-lede">Following curiosity, one question at a time.</p>
        <div class="inquiry-list">
          <p>
            Systems &amp; software <span>How the pieces fit together.</span>
          </p>
          <p>
            Data &amp; patterns <span>Learning by asking.</span>
          </p>
          <p>
            Physics &amp; philosophy <span>For the questions themselves.</span>
          </p>
        </div>
        <a class="text-link" href="/learning/">
          Follow the questions <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
    <section
      class="journey-chapter"
      id="writing"
      data-chapter="writing"
      aria-labelledby="record-title"
    >
      <div class="chapter-copy">
        <p class="chapter-kicker mono">05 / Notes in the margins</p>
        <h2 id="record-title">
          Some thoughts
          <br />
          <em>need time.</em>
        </h2>
        {writing.length ? (
          <>
            <p class="chapter-lede">
              Thoughts on building, learning, and finding meaning along the way.
            </p>
            <ol class="journey-projects">
              {writing.slice(0, 3).map(({ data }) => (
                <li>
                  <a href={`/writing/${data.slug}/`}>
                    <span class="mono">↗</span>
                    <span>{data.title}</span>
                  </a>
                </li>
              ))}
            </ol>
          </>
        ) : (
          <>
            <p class="chapter-lede">
              I’m collecting ideas before giving them a permanent home here.
              Essays and notes will arrive as they are ready.
            </p>
            <p class="forthcoming mono">The first page is still open.</p>
          </>
        )}
        <a class="text-link" href="/writing/">
          Visit the writing archive <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
    <section
      class="journey-chapter"
      id="contact"
      data-chapter="contact"
      aria-labelledby="signal-title"
    >
      <div class="chapter-copy">
        <p class="chapter-kicker mono">06 / The return</p>
        <h2 id="signal-title">
          Every ending,
          <br />
          <em>a beginning.</em>
        </h2>
        <p class="chapter-lede">
          For work, an interesting question,
          <br />
          or a shared curiosity.
        </p>
        <a class="text-link" href="/contact/">
          Start a conversation <span aria-hidden="true">↗</span>
        </a>
        <a
          class="chapter-github mono"
          href="https://github.com/RishiP44"
          target="_blank"
          rel="noopener noreferrer"
        >
          Find me on GitHub ↗
        </a>
        <p class="closing-note">Everything moves around nothing.</p>
        <a class="journey-next mono" href="#drawing">
          Begin again <span aria-hidden="true">↑</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
