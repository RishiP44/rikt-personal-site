---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import AboutSection from "../components/AboutSection.astro";
import machine from "../assets/machine.svg?raw";
---

<BaseLayout
  home
  title="This is my design"
  description="A personal drawing board by Rishi Patel. Explore work, projects, learning, and ideas through the RIKT Paradox Machine."
>
  <nav class="page-dots" aria-label="Sections">
    <a href="#drawing" aria-label="The drawing" aria-current="true"></a>
    <a href="#about" aria-label="The person" aria-current="false"></a>
  </nav>
  <section class="screen drafting" id="drawing" aria-labelledby="intro-title">
    <SiteHeader home />
    <div class="intro">
      <div class="eyebrow">AN ONGOING EXPLORATION</div>
      <h1 id="intro-title">
        This is <br />
        my <em>design.</em>
      </h1>
      <p>
        A collection of things I build,
        <br />
        questions I follow, and the
        <br />
        person I’m becoming.
      </p>
      <div class="signature">Rishi Patel</div>
    </div>
    <div class="drawing-wrap" set:html={machine} />
    <p class="drawing-status" aria-live="polite">
      Every part has a story. Choose one to begin.
    </p>
    <div class="drawing-notes">
      FIG. 01 — THE PARADOX MACHINE
      <br />
      EVERYTHING MOVES AROUND NOTHING.
    </div>
    <div class="screen-footer">
      <div class="folio">
        <span>
          <b>RIKT / 001</b>
        </span>
        <span class="edition">PERSONAL APPARATUS · 2026</span>
      </div>
      <a class="scroll-link" href="#about">
        THE PERSON BEHIND THE DRAWING <span aria-hidden="true">↓</span>
      </a>
      <span>OTTAWA, CANADA</span>
    </div>
  </section>
  <AboutSection />
</BaseLayout>
