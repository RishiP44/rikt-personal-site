---
import BaseLayout from "../layouts/BaseLayout.astro";
import OuroborosScene from "../components/OuroborosScene.astro";
import "../styles/apparatus.css";
---

<BaseLayout
  title="RIKT"
  description="Rishi Patel’s personal collection of work, projects, learning, and writing."
  home
>
  <header class="sculpture-header">
    <h1>
      <a href="/" aria-label="RIKT — Rishi Patel">
        RIKT<span>Rishi Patel</span>
      </a>
    </h1>
    <span class="edition mono" aria-hidden="true">
      Study 02 / An endless return
    </span>
  </header>
  <section id="drawing" aria-label="Sisyphus and the Ouroboros">
    <OuroborosScene />
  </section>
</BaseLayout>
