---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="The work."
  description="Experience across software, data, and the systems between them."
>
  <div class="page-heading">
    <div class="eyebrow">02 / DRIVE ASSEMBLY</div>
    <h1>The work.</h1>
    <p class="summary">
      Experience across software, data, and the systems between them.
    </p>
  </div>
  <div class="entries">
    <article class="entry">
      <div class="mono">2026</div>
      <div>
        <h2>Algonquin College</h2>
        <div class="project-meta">Monograph Development Assistant</div>
        <div class="project-meta">HTML · CMS · PYTHON</div>
      </div>
      <p>
        Worked on program information in HTML and the college’s content
        management system, using Python and regular expressions to simplify
        repetitive conversion and formatting work.
      </p>
    </article>
    <article class="entry">
      <div class="mono">2025</div>
      <div>
        <h2>Ascend Marketing</h2>
        <div class="project-meta">Technical Product Manager</div>
        <div class="project-meta">PRODUCT · AGILE · INTEGRATIONS</div>
      </div>
      <p>
        Helped shape an MVP through requirements, user stories, and sprint
        planning. Worked across product and technical support to improve
        workflows and integrations.
      </p>
    </article>
    <article class="entry">
      <div class="mono">2025</div>
      <div>
        <h2>AM/NS India</h2>
        <div class="project-meta">BI & Data Engineering Intern</div>
        <div class="project-meta">SQL · BIGQUERY · POWER BI</div>
      </div>
      <p>
        Worked with SQL data pipelines and Power BI reporting, helping turn
        operational data into information teams could use.
      </p>
    </article>
  </div>
</BaseLayout>
