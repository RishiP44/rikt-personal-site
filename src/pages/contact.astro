---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="A conversation begins."
  description="For work, an interesting question, or a shared curiosity."
  noindex
>
  <div class="page-heading">
    <div class="eyebrow">06 / SIGNAL ASSEMBLY</div>
    <h1>A conversation begins.</h1>
    <p class="summary">
      For work, an interesting question, or a shared curiosity.
    </p>
  </div>
  <div class="entries">
    <div class="contact-block">
      <div class="eyebrow">FIND ME ON GITHUB</div>
      <p>
        <a
          href="https://github.com/RishiP44"
          target="_blank"
          rel="noopener noreferrer"
        >
          github.com/RishiP44 ↗
        </a>
      </p>
      <p>Explore my repositories and the things I’m working on.</p>
    </div>
    <div class="contact-block">
      <div class="eyebrow">BASED IN</div>
      <p>Ottawa, Canada.</p>
      <p class="placeholder-note">
        A direct email link will be added here once the contact address for this
        site is chosen.
      </p>
    </div>
  </div>
</BaseLayout>
