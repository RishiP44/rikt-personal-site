---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentNotice from "../components/ContentNotice.astro";
import { Content, frontmatter } from "../content/about.md";
const status = frontmatter.status === "published" ? "published" : "placeholder";
---

<BaseLayout
  title="The person behind it."
  description={frontmatter.description}
  noindex={status !== "published"}
>
  <div class="page-heading">
    <div class="eyebrow">01 / IDENTITY REGISTER</div>
    <h1>
      The person
      <br />
      <em>behind it.</em>
    </h1>
    <p class="summary">{frontmatter.lede}</p>
  </div>
  <div class="prose">
    <ContentNotice status={status} />
    <Content />
  </div>
</BaseLayout>
