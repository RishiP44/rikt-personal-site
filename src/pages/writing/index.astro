---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EntryList from "../../components/EntryList.astro";
import { getPublished } from "../../lib/content";
const entries = await getPublished("writing");
---

<BaseLayout
  title="Notes in the margins."
  description="Thoughts on building, learning, and finding meaning along the way."
  noindex={entries.length === 0}
>
  <div class="page-heading">
    <div class="eyebrow">05 / RECORDING MECHANISM</div>
    <h1>Notes in the margins.</h1>
    <p class="summary">
      Thoughts on building, learning, and finding meaning along the way.
    </p>
  </div>
  {entries.length ? (
    <EntryList archive="writing" entries={entries} />
  ) : (
    <div class="entries">
      <div class="contact-block">
        <p class="mono">THE FIRST PAGE IS STILL OPEN</p>
        <p class="placeholder-note">
          I’m collecting ideas before giving them a permanent home here. Essays
          and notes will arrive as they are ready.
        </p>
        <p class="placeholder-note">No articles have been published yet.</p>
      </div>
    </div>
  )}
</BaseLayout>
