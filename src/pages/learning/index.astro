---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EntryList from "../../components/EntryList.astro";
import { getPublished } from "../../lib/content";
const entries = await getPublished("learning");
const subjects = [...new Set(entries.map(({ data }) => data.subject))].sort();
---

<BaseLayout
  title="Following the questions."
  description="A place for the subjects I return to, and the things I am still figuring out."
  noindex={entries.length === 0}
>
  <div class="page-heading">
    <div class="eyebrow">04 / OBSERVATION INSTRUMENT</div>
    <h1>Following the questions.</h1>
    <p class="summary">
      A place for the subjects I return to, and the things I am still figuring
      out.
    </p>
  </div>
  <div class="entries">
    <article class="entry">
      <div class="mono">01</div>
      <div>
        <h2>Systems & software</h2>
        <div class="project-meta">Building a foundation</div>
        <div class="project-meta">SOFTWARE · DATABASES · TESTING</div>
      </div>
      <p>
        Computer Programming and Analysis at Algonquin College. An ongoing
        interest in APIs, databases, testing, and how the pieces of a system fit
        together.
      </p>
    </article>
    <article class="entry">
      <div class="mono">02</div>
      <div>
        <h2>Data & patterns</h2>
        <div class="project-meta">Learning by asking</div>
        <div class="project-meta">SQL · ANALYTICS · VISUALISATION</div>
      </div>
      <p>
        SQL, data modelling, and analytics. Working through the process of
        turning a broad question into something data can help answer.
      </p>
    </article>
    <article class="entry">
      <div class="mono">03</div>
      <div>
        <h2>Physics & philosophy</h2>
        <div class="project-meta">For the questions themselves</div>
        <div class="project-meta">TIME · INFORMATION · CURIOSITY</div>
      </div>
      <p>
        An interest in time, information, consciousness, and the nature of
        reality. Reading notes and reflections are still taking shape.
      </p>
    </article>
  </div>
  <section class="archive-records" aria-labelledby="by-subject">
    <h2 id="by-subject">Learning records by subject</h2>
    {subjects.map((subject) => (
      <section>
        <h3>{subject}</h3>
        <EntryList
          archive="learning"
          entries={entries.filter(({ data }) => data.subject === subject)}
        />
      </section>
    ))}
    {entries.length === 0 && (
      <p class="placeholder-note">
        No learning records have been published yet. Good things take time.
      </p>
    )}
  </section>
  {entries.length > 0 && (
    <section class="archive-records" aria-labelledby="chronological">
      <h2 id="chronological">Chronological</h2>
      <EntryList archive="learning" entries={entries} />
    </section>
  )}
</BaseLayout>
